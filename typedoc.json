{
  "$schema": "https://typedoc.org/schema.json",
  "name": "Tadabut",
  "entryPoints": ["src/index.ts", "src/react/index.tsx", "src/vue/index.ts"],
  "plugin": ["typedoc-plugin-markdown", "./docs/typedoc-titles.mjs"],
  "out": "docs/src/content/docs/api",
  "readme": "none",
  "entryFileName": "index",
  "outputFileStrategy": "modules",
  "hidePageTitle": true,
  "hideBreadcrumbs": true,
  "hidePageHeader": true,
  "excludePrivate": true,
  "excludeInternal": true,
  "sort": ["kind", "alphabetical"],
  "validation": {
    "notExported": false
  }
}
