{
  "name": "tadabut",
  "version": "0.5.0",
  "description": "Typed wrapper for DataTables with row editing, rich inputs and chained selects.",
  "keywords": [
    "datatables",
    "datatables.net",
    "table",
    "datagrid",
    "editable",
    "inline-editing",
    "row-editing",
    "chained-select",
    "dependent-select",
    "typescript",
    "react"
  ],
  "author": "Anas Youssef ELMAHDAD <elmahdad.anasyoussef00@proton.me> (https://github.com/ayem1412)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ayem1412/tadabut.git"
  },
  "homepage": "https://ayem1412.github.io/tadabut/",
  "bugs": "https://github.com/ayem1412/tadabut/issues",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "docs": "pnpm dlx --package typedoc@0.28.20 --package typescript@6.0.x typedoc",
    "dev": "vite",
    "build": "tsdown",
    "test": "vitest",
    "typecheck": "tsc",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "biome ci . && tsc && vitest run && tsdown"
  },
  "peerDependencies": {
    "datatables.net": "^3.0.0",
    "react": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@biomejs/biome": "2.5.15",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "bootstrap": "^5.3.8",
    "datatables.net": "^3.1.5",
    "datatables.net-bs5": "^3.1.5",
    "datatables.net-dt": "^3.1.5",
    "jsdom": "^30.1.3",
    "publint": "^0.3.25",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@12.18.0",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.18.0",
      "onFail": "download"
    }
  },
  "exports": {
    ".": "./dist/index.js",
    "./react": "./dist/react.js",
    "./package.json": "./package.json"
  }
}
