{
  "name": "tadabut",
  "version": "1.1.0",
  "description": "Typed wrapper for DataTables with row editing, rich inputs and chained selects.",
  "keywords": [
    "datatables",
    "datatables.net",
    "table",
    "datagrid",
    "editable",
    "inline-editing",
    "row-editing",
    "chained-select",
    "dependent-select",
    "typescript",
    "react"
  ],
  "author": "Anas Youssef ELMAHDAD <elmahdad.anasyoussef00@proton.me> (https://github.com/ayem1412)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ayem1412/tadabut.git"
  },
  "homepage": "https://ayem1412.github.io/tadabut/",
  "bugs": "https://github.com/ayem1412/tadabut/issues",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "docs:api": "pnpm dlx --package typedoc@0.28.20 --package typedoc-plugin-markdown@4.14.1 --package typescript@6.0.x typedoc",
    "docs:dev": "pnpm run docs:api && astro dev --root docs",
    "docs": "pnpm run docs:api && astro build --root docs",
    "dev": "vite",
    "build": "tsdown",
    "test": "vitest",
    "typecheck": "tsc",
    "lint": "biome check .",
    "format": "biome check --write . && prettier --write \"docs/src/content/**/*.{md,mdx}\"",
    "check": "biome ci . && prettier --check \"docs/src/content/**/*.{md,mdx}\" && tsc && vitest run && tsdown"
  },
  "peerDependencies": {
    "datatables.net": "^3.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vue": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@astrojs/markdown-remark": "^7.3.10",
    "@astrojs/starlight": "~0.42.11",
    "@biomejs/biome": "2.6.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/test-utils": "^2.6.0",
    "astro": "^7.4.13",
    "astro-rehype-relative-markdown-links": "^0.19.2",
    "bootstrap": "^5.3.9",
    "datatables.net": "^3.1.6",
    "datatables.net-bs5": "^3.1.6",
    "datatables.net-dt": "^3.1.6",
    "jsdom": "^30.1.3",
    "prettier": "^3.10.1",
    "publint": "^0.3.25",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "starlight-ion-theme": "^2.4.1",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "vue": "^3.5.46"
  },
  "packageManager": "pnpm@12.23.0",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.23.0",
      "onFail": "download"
    }
  },
  "exports": {
    ".": "./dist/index.js",
    "./react": "./dist/react.js",
    "./vue": "./dist/vue.js",
    "./package.json": "./package.json"
  }
}
